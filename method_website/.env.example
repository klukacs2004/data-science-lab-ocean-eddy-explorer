# Generated as .env by run.py. Environment variables override this file.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=

# Paths are relative to this method_website directory unless absolute.
# Leave SLA_DATA_DIR blank to discover ../data or ./data automatically.
SLA_DATA_DIR=
DJANGO_RUNTIME_DIR=.runtime
DJANGO_DATABASE_PATH=
COMPARISON_WORK_DIR=
COMPARISON_AUTOSTART=true

# Set this to the published URL's path when using a prefix-stripping proxy.
# Example: /user/alice/proxy/8000
DJANGO_FORCE_SCRIPT_NAME=
DJANGO_TRUST_PROXY=false
DJANGO_SECURE_COOKIES=false
DJANGO_X_FRAME_OPTIONS=SAMEORIGIN

BIND_HOST=127.0.0.1
PORT=8000
WEB_TIMEOUT=1200
