# Copy to .env, replace the example hostname/path, then run run.py --prepare.
# The launcher fills an empty DJANGO_SECRET_KEY with a private generated key.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,kooplex.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://kooplex.example.org

# Use the persistent data directory mounted in your Kooplex environment.
SLA_DATA_DIR=
DJANGO_RUNTIME_DIR=.runtime
DJANGO_DATABASE_PATH=.runtime/db.sqlite3
COMPARISON_WORK_DIR=.runtime/comparison_work
COMPARISON_AUTOSTART=true

# The path component only, without scheme, hostname, or trailing slash.
# Leave empty if the platform publishes the application at its URL root.
# A proxy must strip this prefix before forwarding requests to Django.
DJANGO_FORCE_SCRIPT_NAME=

# Enable only behind the Kooplex proxy that sets X-Forwarded-Proto itself.
DJANGO_TRUST_PROXY=true
DJANGO_SECURE_COOKIES=true
DJANGO_X_FRAME_OPTIONS=SAMEORIGIN

BIND_HOST=0.0.0.0
PORT=8000
WEB_TIMEOUT=1200
